{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent platform role parameters",
  "description": "Role prompt strings use catalog references or a single template expression.",
  "$ref": "#/$defs/value",
  "$defs": {
    "value": {
      "patternProperties": {
        "^(prompt|system_prompt|prompt_template|persona|instructions|system_message|developer_message)$": {
          "allOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "$ref": "#/$defs/catalogPrompt"
            }
          ]
        },
        "(^|_)(prompt_template|persona|instructions|system_message|developer_message)$": {
          "allOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "$ref": "#/$defs/catalogPrompt"
            }
          ]
        },
        "(^|_)(system_)?prompt$": {
          "allOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "$ref": "#/$defs/shortPrompt"
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      },
      "items": {
        "$ref": "#/$defs/value"
      }
    },
    "catalogPrompt": {
      "if": {
        "type": "string"
      },
      "then": {
        "$ref": "#/$defs/catalogReference"
      }
    },
    "shortPrompt": {
      "if": {
        "type": "string"
      },
      "then": {
        "anyOf": [
          {
            "$ref": "#/$defs/catalogReference"
          },
          {
            "$ref": "#/$defs/atMostTwoSentences"
          }
        ]
      }
    },
    "catalogReference": {
      "pattern": "^\\{\\{(?:(?!\\}\\})[\\s\\S])*\\}\\}$(?![\\s\\S])|^[A-Za-z0-9][A-Za-z0-9._/@:-]*$(?![\\s\\S])"
    },
    "atMostTwoSentences": {
      "not": {
        "pattern": "[.!?](?:[ \\t\\r\\n]+|$)[\\s\\S]*[.!?](?:[ \\t\\r\\n]+|$)[\\s\\S]*[.!?](?:[ \\t\\r\\n]+|$)"
      }
    }
  }
}
