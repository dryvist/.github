{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent platform role parameters",
  "description": "Role parameters use catalog references instead of multiline prompt text.",
  "$ref": "#/$defs/value",
  "$defs": {
    "value": {
      "properties": {
        "prompt": {
          "$ref": "#/$defs/shortPrompt"
        },
        "system_prompt": {
          "$ref": "#/$defs/shortPrompt"
        }
      },
      "patternProperties": {
        "(^|_)(prompt|prompt_template|persona|instructions|system_message|developer_message)$": {
          "allOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "$ref": "#/$defs/catalogPrompt"
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      },
      "items": {
        "$ref": "#/$defs/value"
      }
    },
    "catalogPrompt": {
      "if": {
        "type": "string"
      },
      "then": {
        "anyOf": [
          {
            "pattern": "^\\s*\\{\\{(?:(?!\\{\\{|\\}\\})[\\s\\S])*\\}\\}\\s*$"
          },
          {
            "not": {
              "allOf": [
                {
                  "pattern": "\\S[^\\r\\n]*\\r?\\n[\\s\\S]*\\S"
                },
                {
                  "pattern": "[A-Za-z]{2,}[ \\t]+[A-Za-z]{2,}"
                }
              ]
            }
          }
        ]
      }
    },
    "shortPrompt": {
      "if": {
        "type": "string"
      },
      "then": {
        "not": {
          "pattern": "(?:[^\\n]*\\n){5}[^\\n]+|(?:[^\\n]*\\n){6}"
        }
      }
    }
  }
}
