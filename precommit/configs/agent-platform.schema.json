{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent platform role parameters",
  "description": "Role prompt strings use catalog references or a single template expression.",
  "$ref": "#/$defs/value",
  "$defs": {
    "value": {
      "patternProperties": {
        "(^|_)(prompt|prompt_template|persona|instructions|system_message|developer_message)$": {
          "allOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "$ref": "#/$defs/catalogPrompt"
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      },
      "items": {
        "$ref": "#/$defs/value"
      }
    },
    "catalogPrompt": {
      "if": {
        "type": "string"
      },
      "then": {
        "anyOf": [
          {
            "pattern": "^\\{\\{(?:(?!\\}\\})[\\s\\S])*\\}\\}$(?![\\s\\S])"
          },
          {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:-]*$(?![\\s\\S])"
          }
        ]
      }
    }
  }
}
